# quickstartFunctions 标讯数据库环境变量示例
# 请在云开发控制台配置，不要把真实账号密码提交到源码。
# 推荐：通过服务器本机查询 API 访问数据库。
BIAOXUN_API_URL=https://www.subangroup.com/api/biaoxun
BIAOXUN_API_TOKEN=replace_with_api_token
BIAOXUN_API_TIMEOUT=2500

# 以下数据库配置仅作为 API 未配置时的兼容回退。
BIAOXUN_DB_HOST=47.99.117.191
BIAOXUN_DB_PORT=3306
BIAOXUN_DB_USER=biaoxun
BIAOXUN_DB_PASSWORD=replace_with_secret
BIAOXUN_DB_NAME=biaoxun
BIAOXUN_DB_TABLE=notices
BIAOXUN_DB_TIMEOUT=1800
BIAOXUN_QUERY_TIMEOUT=8000
# Keep schema auto-detection disabled for the known notices table mapping.
BIAOXUN_SCHEMA_AUTO_DETECT=0
BIAOXUN_COLUMN_ID=id
BIAOXUN_COLUMN_TITLE=title
BIAOXUN_COLUMN_PUBLISH_TIME=notice_time
BIAOXUN_COLUMN_BUYER=purchaser
BIAOXUN_COLUMN_AGENCY=agency
BIAOXUN_COLUMN_CATEGORY=notice_type
BIAOXUN_COLUMN_URL=url
BIAOXUN_COLUMN_REGION=region
BIAOXUN_COLUMN_BUDGET=budget
BIAOXUN_COLUMN_SOURCE=source
BIAOXUN_COLUMN_CONTENT=content_html
BIAOXUN_COLUMN_ATTACHMENTS=attchs
