<view class="privacy-mask" wx:if="{{show}}" catchtouchmove="noop">
  <view class="privacy-dialog">
    <view class="privacy-title">{{title}}</view>
    <scroll-view scroll-y class="privacy-content">{{content}}</scroll-view>
    <view class="privacy-link" bindtap="openFullPolicy">查看《用户协议与隐私政策》完整内容</view>
    <view class="privacy-actions">
      <button class="btn-cancel" bindtap="onReject">不同意</button>
      <button class="btn-confirm" bindtap="onAccept">同意并继续</button>
    </view>
  </view>
</view>
