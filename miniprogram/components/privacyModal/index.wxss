.privacy-mask {
  position: fixed;
  inset: 0;
  background: rgba(8, 53, 110, 0.45);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.privacy-dialog {
  width: 100%;
  background: var(--gov-card);
  border-radius: var(--gov-radius-lg);
  padding: 36rpx 32rpx 32rpx;
  border: 1rpx solid var(--gov-border);
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--gov-text);
  text-align: center;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--gov-border-light);
}

.privacy-content {
  max-height: 360rpx;
  font-size: 28rpx;
  color: var(--gov-text-secondary);
  line-height: 1.7;
  margin-bottom: 16rpx;
}

.privacy-link {
  text-align: center;
  font-size: 24rpx;
  color: var(--gov-primary);
  margin-bottom: 24rpx;
  padding: 8rpx 0;
}

.privacy-actions {
  display: flex;
  gap: 16rpx;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--gov-radius);
  font-size: 28rpx;
  border: none;
  letter-spacing: 2rpx;
}

.btn-cancel {
  background: var(--gov-card);
  color: var(--gov-text-secondary);
  border: 1rpx solid var(--gov-border);
}

.btn-confirm {
  background: var(--gov-primary);
  color: #fff;
}
