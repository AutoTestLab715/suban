.bx-card {
  margin-bottom: 18rpx;
  padding: 26rpx 26rpx 22rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e5eaf1;
  box-shadow: 0 4rpx 18rpx rgba(29, 58, 96, 0.04);
  box-sizing: border-box;
}

.bx-card-hover {
  background: #f8fbff;
}

.bx-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.bx-badge {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: #eaf3ff;
  color: #2275d8;
  font-size: 21rpx;
  font-weight: 600;
}

.bx-badge.kjt,
.bx-badge.gxt,
.bx-badge.plap {
  background: #eef8f2;
  color: #1a7f4b;
}

.bx-badge.easy_prt {
  background: #eef1f5;
  color: #6b7785;
}

.bx-badge.ccgp,
.bx-badge.guangdong,
.bx-badge.jiangxi,
.bx-badge.hunan,
.bx-badge.shanghai,
.bx-badge.jiangsu,
.bx-badge.anhui,
.bx-badge.zhejiang,
.bx-badge.sichuan,
.bx-badge.hainan,
.bx-badge.guizhou,
.bx-badge.hubei,
.bx-badge.quanzhou,
.bx-badge.quanzhou_hall {
  background: #e8f1fb;
  color: #1f5fa8;
}

.bx-badge.quanzhou,
.bx-badge.quanzhou_hall {
  background: #f7f0e6;
  color: #8a5a1e;
}

.bx-time {
  flex-shrink: 0;
  color: #8f9aaa;
  font-size: 22rpx;
}

.bx-title {
  display: -webkit-box;
  margin-top: 16rpx;
  overflow: hidden;
  color: #1a2433;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.bx-countdown {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d7e4e0;
  background: linear-gradient(135deg, #f3fbf8, #eef7f4);
}

.bx-countdown.ended {
  background: #f5f6f8;
  border-color: #e5eaf1;
}

.bx-cd-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.bx-cd-label {
  min-width: 0;
  color: #5b7370;
  font-size: 22rpx;
  line-height: 1.3;
}

.bx-cd-price {
  flex-shrink: 0;
  color: #c47a12;
  font-size: 26rpx;
  font-weight: 720;
  line-height: 1.3;
  white-space: nowrap;
}

.bx-cd-value {
  display: block;
  margin-top: 6rpx;
  color: #0f6b57;
  font-size: 34rpx;
  font-weight: 780;
  letter-spacing: 0.04em;
  font-variant-numeric: tabular-nums;
  line-height: 1.25;
}

.bx-countdown.ended .bx-cd-value {
  color: #6b7785;
  font-size: 28rpx;
}

.bx-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.bx-chip {
  max-width: 280rpx;
  padding: 5rpx 12rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #f3f5f8;
  color: #7d8998;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bx-chip.warn {
  background: #fff1df;
  color: #9a7420;
}

.bx-rows {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #edf0f4;
}

.bx-row {
  display: flex;
  align-items: baseline;
  margin-top: 10rpx;
}

.bx-row:first-child {
  margin-top: 0;
}

.bx-label {
  width: 112rpx;
  flex-shrink: 0;
  color: #8f9aaa;
  font-size: 22rpx;
}

.bx-value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #2a3545;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bx-value.gold {
  color: #9a7420;
  font-weight: 600;
}
