.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(221, 228, 236, 0.8);
  box-shadow: 0 2rpx 12rpx rgba(12, 61, 122, 0.04);
}

.nav-dark {
  border-bottom: none;
}

.nav-inner {
  display: flex;
  align-items: center;
  padding-left: 16rpx;
  position: relative;
  box-sizing: border-box;
}

.nav-left {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  z-index: 2;
  min-width: 80rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 16rpx 12rpx 8rpx;
  border-radius: var(--gov-radius, 8rpx);
}

.back-btn:active {
  background: rgba(0, 0, 0, 0.06);
}

.nav-dark .back-btn:active {
  background: rgba(255, 255, 255, 0.12);
}

.back-icon {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #5c6b7a;
  border-bottom: 4rpx solid #5c6b7a;
  transform: rotate(45deg);
  margin-left: 4rpx;
  flex-shrink: 0;
}

.nav-dark .back-icon {
  border-color: rgba(255, 255, 255, 0.92);
}

.back-text {
  font-size: 28rpx;
  color: #5c6b7a;
  font-weight: 500;
}

.nav-dark .back-text {
  color: rgba(255, 255, 255, 0.92);
}

.account-btn {
  padding: 4rpx;
}

.account-btn:active {
  opacity: 0.75;
}

.account-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid var(--gov-border, #d9e2ec);
  background: #f4f6f9;
}

.nav-dark .account-avatar {
  border-color: rgba(255, 255, 255, 0.35);
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: var(--gov-text, #1a1a1a);
  max-width: 50%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  pointer-events: none;
  letter-spacing: 2rpx;
}

.nav-dark .nav-title {
  color: #ffffff;
}

.nav-placeholder {
  width: 100%;
  flex-shrink: 0;
}
