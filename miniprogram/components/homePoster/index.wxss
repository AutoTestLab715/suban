.poster {
  padding-bottom: 8rpx;
  margin-top: 0;
}

/* ===== 主视觉 ===== */
.hero {
  position: relative;
  overflow: hidden;
  color: #fff;
  margin-top: 0;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, #061e3d 0%, #0c3d7a 45%, #1456a8 100%);
}

.hero-glow {
  position: absolute;
  width: 600rpx;
  height: 600rpx;
  top: -200rpx;
  right: -180rpx;
  background: radial-gradient(circle, rgba(184, 148, 46, 0.18) 0%, transparent 70%);
  pointer-events: none;
}

.hero-inner {
  position: relative;
  padding: 48rpx 40rpx 52rpx;
}

.hero-brand {
  display: inline-block;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 36rpx;
  border: 1rpx solid rgba(184, 148, 46, 0.5);
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(184, 148, 46, 0.12);
}

.hero-title {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  line-height: 1.3;
  margin-bottom: 20rpx;
}

.hero-divider {
  width: 64rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #b8942e, #d4b44a);
  border-radius: 2rpx;
  margin-bottom: 20rpx;
}

.hero-subtitle {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.45;
  margin-bottom: 28rpx;
  color: rgba(255, 255, 255, 0.95);
}

.hero-lines {
  padding: 24rpx 28rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  margin-bottom: 28rpx;
}

.hero-line {
  font-size: 28rpx;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.88);
}

.hero-line + .hero-line {
  margin-top: 8rpx;
}

.hero-footer {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
  line-height: 1.65;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
}

/* ===== 通用区块 ===== */
.section {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 28rpx 32rpx;
  border: 1rpx solid #e4eaf0;
  box-shadow: 0 4rpx 24rpx rgba(12, 61, 122, 0.05);
}

.section-head {
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eef1f5;
}

.section-head-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1c2433;
  letter-spacing: 1rpx;
}

.section-en {
  font-size: 22rpx;
  color: #b8942e;
  letter-spacing: 3rpx;
  font-weight: 500;
}

/* ===== 服务列表 ===== */
.service-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.service-card {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  border: 1rpx solid #e8edf3;
}

.service-index {
  flex-shrink: 0;
  width: 48rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #b8942e;
  line-height: 1.2;
  padding-top: 4rpx;
}

.service-body {
  flex: 1;
  min-width: 0;
}

.service-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
  flex-wrap: wrap;
}

.service-tag {
  font-size: 22rpx;
  color: #0c3d7a;
  background: #eef4fb;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-weight: 600;
  border: 1rpx solid #c5d9ef;
}

.service-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c2433;
  line-height: 1.35;
}

.service-desc {
  font-size: 26rpx;
  color: #5a6577;
  line-height: 1.65;
}

/* ===== 融资服务 ===== */
.finance-bar {
  margin: 20rpx 24rpx 0;
  background: linear-gradient(145deg, #061e3d 0%, #0c3d7a 100%);
  border-radius: 20rpx;
  padding: 36rpx 28rpx;
  color: #fff;
  box-shadow: 0 8rpx 32rpx rgba(6, 30, 61, 0.2);
}

.finance-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 12rpx;
}

.finance-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
}

.finance-en {
  font-size: 22rpx;
  color: #d4b44a;
  letter-spacing: 3rpx;
  font-weight: 500;
}

.finance-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.65;
  margin-bottom: 28rpx;
}

.finance-stats {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.finance-stat {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.07);
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.finance-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #d4b44a;
  flex-shrink: 0;
  margin-right: 20rpx;
  font-variant-numeric: tabular-nums;
}

.finance-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.45;
  text-align: right;
  flex: 1;
}

/* ===== 核心优势 ===== */
.adv-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.adv-item {
  width: calc(50% - 6rpx);
  background: #f8fafc;
  border: 1rpx solid #e8edf3;
  border-radius: 14rpx;
  padding: 28rpx 16rpx;
  text-align: center;
  box-sizing: border-box;
}

.adv-item:nth-child(5) {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx;
}

.adv-item:nth-child(5) .adv-value,
.adv-item:nth-child(5) .adv-label {
  margin-bottom: 0;
}

.adv-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #0c3d7a;
  margin-bottom: 6rpx;
}

.adv-label {
  font-size: 26rpx;
  color: #5a6577;
}

/* ===== 服务流程 ===== */
.process-list {
  display: flex;
  flex-direction: column;
}

.process-item {
  display: flex;
  gap: 20rpx;
}

.process-track {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 48rpx;
}

.process-step {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #0c3d7a;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 50%;
  flex-shrink: 0;
}

.process-line {
  width: 2rpx;
  flex: 1;
  min-height: 32rpx;
  background: linear-gradient(180deg, #c5d9ef 0%, #e8edf3 100%);
  margin: 8rpx 0;
}

.process-body {
  flex: 1;
  padding-bottom: 32rpx;
}

.process-item:last-child .process-body {
  padding-bottom: 0;
}

.process-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c2433;
  margin-bottom: 6rpx;
  padding-top: 6rpx;
}

.process-desc {
  font-size: 26rpx;
  color: #5a6577;
  line-height: 1.55;
}

/* ===== 联系我们 ===== */
.contact-card {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 28rpx;
  border: 1rpx solid #e4eaf0;
  box-shadow: 0 4rpx 24rpx rgba(12, 61, 122, 0.05);
}

.contact-head {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 20rpx;
}

.contact-slogan {
  font-size: 32rpx;
  font-weight: 700;
  color: #1c2433;
  line-height: 1.45;
}

.contact-en {
  font-size: 22rpx;
  color: #b8942e;
  letter-spacing: 3rpx;
  font-weight: 500;
}

.contact-divider {
  height: 1rpx;
  background: #eef1f5;
  margin-bottom: 24rpx;
}

.contact-row {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 20rpx;
}

.contact-label {
  font-size: 24rpx;
  color: #8b95a5;
  letter-spacing: 1rpx;
}

.contact-phone {
  font-size: 32rpx;
  font-weight: 600;
  color: #0c3d7a;
  letter-spacing: 2rpx;
}

.contact-address {
  font-size: 28rpx;
  color: #5a6577;
  line-height: 1.6;
}

.contact-note {
  font-size: 24rpx;
  color: #8b95a5;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef1f5;
  line-height: 1.55;
}
