page {
  background: #f0f2f5;
  height: 100vh;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.content {
  flex: 1;
  height: 0;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.doc-head {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx 36rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(12, 61, 122, 0.06);
}

.doc-brand {
  display: inline-block;
  font-size: 22rpx;
  color: #0c3d7a;
  letter-spacing: 4rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid rgba(12, 61, 122, 0.2);
  border-radius: 999rpx;
  margin-bottom: 20rpx;
}

.doc-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1c2433;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.doc-meta {
  font-size: 24rpx;
  color: #8b95a5;
}

.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(12, 61, 122, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0c3d7a;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #0c3d7a;
}

.paragraph {
  font-size: 26rpx;
  color: #5a6577;
  line-height: 1.85;
  margin-bottom: 16rpx;
  text-align: justify;
}

.paragraph:last-child {
  margin-bottom: 0;
}

.footer-para {
  margin-top: 8rpx;
}

.list {
  margin: 8rpx 0 16rpx;
}

.sub-list {
  margin-top: 0;
}

.list-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.dot {
  color: #0c3d7a;
  font-size: 28rpx;
  line-height: 1.6;
  flex-shrink: 0;
}

.li-text {
  flex: 1;
  font-size: 26rpx;
  color: #5a6577;
  line-height: 1.75;
  text-align: justify;
}

.doc-actions {
  padding: 16rpx 0 24rpx;
}

.call-btn {
  background: linear-gradient(135deg, #0c3d7a 0%, #082d5c 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  border: none;
}

.call-btn::after {
  border: none;
}
