page {
  background: #f0f4f8;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.page-bg {
  position: fixed;
  inset: 0;
  z-index: 0;
  background: linear-gradient(165deg, #061e3d 0%, #0c3d7a 38%, #eef4fb 38%, #f0f4f8 100%);
}

.bg-blob {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.bg-blob-a {
  width: 360rpx;
  height: 360rpx;
  top: -80rpx;
  right: -100rpx;
  background: radial-gradient(circle, rgba(184, 148, 46, 0.2) 0%, transparent 70%);
}

.bg-blob-b {
  width: 280rpx;
  height: 280rpx;
  top: 120rpx;
  left: -120rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.12) 0%, transparent 70%);
}

.bg-grid {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 38vh;
  opacity: 0.06;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.8) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255, 255, 255, 0.8) 1rpx, transparent 1rpx);
  background-size: 48rpx 48rpx;
}

.login-body {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.brand-block {
  padding: 32rpx 16rpx 0;
  color: #ffffff;
}

.brand-logo {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 28rpx;
}

.logo-inner {
  position: relative;
  z-index: 2;
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.logo-ring {
  position: absolute;
  inset: -12rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(184, 148, 46, 0.35);
  z-index: 1;
}

.brand-name {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.brand-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.5;
}

.brand-divider {
  width: 48rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #b8942e, rgba(255, 255, 255, 0.5));
  border-radius: 2rpx;
  margin: 28rpx 0 24rpx;
}

.feature-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.feature-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
}

.tag-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #b8942e;
}

.login-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx 36rpx 36rpx;
  box-shadow: 0 16rpx 48rpx rgba(12, 61, 122, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}

.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1c2433;
  text-align: center;
  margin-bottom: 8rpx;
}

.card-sub {
  font-size: 24rpx;
  color: #8b95a5;
  text-align: center;
  margin-bottom: 36rpx;
}

.btn-login {
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  border: none;
  padding: 0;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.28);
  margin-bottom: 28rpx;
}

.btn-login::after {
  border: none;
}

.btn-login[disabled] {
  opacity: 0.45;
  box-shadow: none;
}

.btn-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.privacy-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 32rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #0c3d7a;
  border-color: #0c3d7a;
}

.check-mark {
  color: #fff;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 700;
}

.privacy-text {
  font-size: 24rpx;
  color: #8b95a5;
}

.privacy-link {
  font-size: 24rpx;
  color: #0c3d7a;
}

.trust-row {
  display: flex;
  justify-content: space-around;
  padding-top: 28rpx;
  border-top: 1rpx solid #f1f5f9;
}

.trust-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.trust-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #eef4fb;
  position: relative;
}

.trust-icon.shield::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 18rpx;
  border: 3rpx solid #0c3d7a;
  border-radius: 4rpx 4rpx 8rpx 8rpx;
  border-top: none;
}

.trust-icon.lock::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 54%;
  transform: translate(-50%, -50%);
  width: 14rpx;
  height: 10rpx;
  border: 3rpx solid #0c3d7a;
  border-radius: 3rpx;
}

.trust-icon.lock::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 30%;
  transform: translateX(-50%);
  width: 10rpx;
  height: 8rpx;
  border: 3rpx solid #0c3d7a;
  border-bottom: none;
  border-radius: 8rpx 8rpx 0 0;
}

.trust-icon.eye::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 18rpx;
  height: 10rpx;
  border: 3rpx solid #0c3d7a;
  border-radius: 50%;
}

.trust-icon.eye::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 6rpx;
  height: 6rpx;
  background: #0c3d7a;
  border-radius: 50%;
}
