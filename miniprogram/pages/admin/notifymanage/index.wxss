page {
  background: var(--gov-bg);
  min-height: 100vh;
}

.page {
  padding: 0 24rpx 80rpx;
}

.header {
  margin-top: 20rpx;
  padding: 24rpx;
  background: var(--gov-card);
  border-radius: var(--gov-radius-lg);
  border: 1rpx solid var(--gov-border);
}

.header-desc {
  font-size: 26rpx;
  color: var(--gov-text-muted);
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.create-btn {
  background: var(--gov-primary);
  color: #fff;
  border: none;
}

.loading,
.empty {
  text-align: center;
  padding: 100rpx 24rpx;
  color: var(--gov-text-muted);
  font-size: 28rpx;
}

.empty-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.list {
  margin-top: 20rpx;
}

.card {
  background: var(--gov-card);
  border-radius: var(--gov-radius-lg);
  border: 1rpx solid var(--gov-border);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--gov-shadow);
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gov-text);
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.tag.on {
  background: #e8f5ee;
  color: var(--gov-success);
}

.tag.off {
  background: #f5f5f5;
  color: var(--gov-text-muted);
}

.card-meta {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--gov-text-muted);
}

.card-warn {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #c77700;
}

.card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--gov-border);
}

.action {
  font-size: 26rpx;
  color: var(--gov-primary);
}

.action.primary {
  font-weight: 600;
}

.action.danger {
  color: #c0392b;
}

.footer-link {
  margin-top: 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--gov-primary);
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.editor {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
}

.editor-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  font-size: 26rpx;
  color: var(--gov-text-muted);
  margin-bottom: 12rpx;
}

.form-item.row .label {
  margin-bottom: 0;
}

.input,
.picker-val {
  background: var(--gov-bg);
  border-radius: var(--gov-radius);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.editor-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: var(--gov-radius);
}

.btn.ghost {
  background: #f5f7fa;
  color: var(--gov-text);
}

.btn.primary {
  background: var(--gov-primary);
  color: #fff;
}
