page {
  background: #f1f5f9;
  min-height: 100vh;
}

.page {
  padding: 24rpx 24rpx 80rpx;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #94a3b8;
}

.header-tip {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.save-btn {
  background: #0d4a9c;
  color: #fff;
  border-radius: 16rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
  border: none;
}
