page {
  background: #f1f5f9;
  min-height: 100vh;
}

.page {
  padding: 24rpx 24rpx 80rpx;
}

.hero {
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.5;
}

.input-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.code-input {
  height: 96rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.verify-btn {
  background: #0d4a9c;
  color: #fff;
  border-radius: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border: none;
}

.result-card {
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.result-card.ok {
  background: #dcfce7;
  color: #166534;
}

.result-card.fail {
  background: #fef2f2;
  color: #b91c1c;
}

.detail-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.detail-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 16rpx;
}

.detail-row {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.8;
}
