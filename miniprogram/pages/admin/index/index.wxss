page {
  background: var(--gov-bg);
  min-height: 100vh;
}

.page {
  padding: 0 24rpx 60rpx;
}

.admin-menu {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin: 20rpx 0 24rpx;
}

.menu-item {
  background: var(--gov-card);
  border: 1rpx solid var(--gov-border);
  border-radius: var(--gov-radius);
  padding: 20rpx 8rpx;
  text-align: center;
  box-shadow: var(--gov-shadow);
}

.menu-item:active {
  background: var(--gov-primary-light);
  border-color: #b8d4f0;
}

.menu-item.active {
  background: var(--gov-primary);
  border-color: var(--gov-primary);
}

.menu-item.active .menu-label {
  color: #fff;
}

.menu-label {
  font-size: 22rpx;
  color: var(--gov-text);
  line-height: 1.4;
}

.notify-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff8e6;
  border: 1rpx solid #ffe0a3;
  border-radius: var(--gov-radius);
}

.notify-banner-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--gov-warning);
  line-height: 1.5;
}

.notify-banner-link {
  font-size: 24rpx;
  color: var(--gov-primary);
  font-weight: 600;
  flex-shrink: 0;
}

.batch-bar {
  background: var(--gov-card);
  border-radius: var(--gov-radius-lg);
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--gov-border);
  box-shadow: var(--gov-shadow);
}

.batch-count {
  font-size: 26rpx;
  color: var(--gov-text-secondary);
  display: block;
  margin-bottom: 12rpx;
}

.batch-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.batch-btn {
  font-size: 24rpx;
  color: var(--gov-primary);
  background: var(--gov-primary-light);
  padding: 10rpx 20rpx;
  border-radius: var(--gov-radius);
  border: 1rpx solid #b8d4f0;
}

.batch-btn.warn {
  color: var(--gov-warning);
  background: #fff8e6;
  border-color: #ffe0a3;
}

.batch-btn.danger {
  color: #fff;
  background: var(--gov-red);
  border-color: var(--gov-red);
}

.card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.card.selected {
  border: 2rpx solid var(--gov-primary);
}

.card-body {
  flex: 1;
  min-width: 0;
}

.select-box {
  padding-top: 8rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--gov-border);
  border-radius: var(--gov-radius);
  text-align: center;
  line-height: 36rpx;
  font-size: 24rpx;
  color: #fff;
}

.checkbox.checked {
  background: var(--gov-primary);
  border-color: var(--gov-primary);
}

.stats-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.search-box {
  flex: 1;
  position: relative;
  background: var(--gov-card);
  border-radius: var(--gov-radius);
  border: 1rpx solid var(--gov-border);
  padding: 0 24rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  height: 72rpx;
}

.search-clear {
  font-size: 36rpx;
  color: var(--gov-text-muted);
  padding: 0 8rpx;
  line-height: 1;
}

.export-btn {
  background: var(--gov-primary);
  color: #fff;
  border: none;
  border-radius: var(--gov-radius);
  font-size: 24rpx;
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  white-space: nowrap;
}

.batch-toggle-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 160rpx;
  height: 64rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  color: var(--gov-primary);
  background: var(--gov-card);
  border: 1rpx solid var(--gov-primary);
  border-radius: var(--gov-radius);
}

.batch-toggle-btn.active {
  color: #fff;
  background: var(--gov-primary);
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.date-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  flex-wrap: wrap;
}

.date-pill {
  font-size: 24rpx;
  color: var(--gov-text-muted);
  background: var(--gov-card);
  border: 1rpx solid var(--gov-border);
  border-radius: var(--gov-radius);
  padding: 12rpx 20rpx;
}

.date-pill.active {
  color: var(--gov-primary);
  border-color: var(--gov-primary);
  background: var(--gov-primary-light);
}

.date-sep {
  font-size: 24rpx;
  color: var(--gov-text-muted);
}

.date-clear {
  font-size: 24rpx;
  color: var(--gov-text-secondary);
  padding: 8rpx;
}

.stat-card {
  flex: 1;
  background: var(--gov-card);
  border-radius: var(--gov-radius-lg);
  padding: 20rpx 12rpx;
  text-align: center;
  border: 1rpx solid var(--gov-border);
  box-shadow: var(--gov-shadow);
}

.stat-card.active {
  border-color: var(--gov-primary);
  background: var(--gov-primary);
}

.stat-card.active .stat-num,
.stat-card.active .stat-label {
  color: #fff;
}

.stat-card.pending.active {
  border-color: var(--gov-warning);
  background: var(--gov-warning);
}

.stat-card.processed.active {
  border-color: var(--gov-success);
  background: var(--gov-success);
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--gov-text);
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--gov-text-muted);
}

.loading,
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: var(--gov-text-muted);
  font-size: 28rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card {
  background: var(--gov-card);
  border-radius: var(--gov-radius-lg);
  padding: 24rpx;
  border: 1rpx solid var(--gov-border);
  box-shadow: var(--gov-shadow);
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--gov-border-light);
}

.card-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-type {
  background: var(--gov-primary-light);
  color: var(--gov-primary);
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--gov-radius);
  border: 1rpx solid #b8d4f0;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--gov-radius);
}

.status-pending {
  background: #fff8e6;
  color: var(--gov-warning);
}

.status-processed {
  background: #edf7f0;
  color: var(--gov-success);
}

.status-rejected {
  background: #fef2f2;
  color: var(--gov-red);
}

.status-unpaid {
  background: var(--gov-primary-light);
  color: var(--gov-primary);
}

.card-time {
  font-size: 22rpx;
  color: var(--gov-text-muted);
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gov-text);
  margin-bottom: 8rpx;
}

.card-form-no {
  font-size: 24rpx;
  color: var(--gov-primary);
  margin-bottom: 8rpx;
}

.card-content {
  font-size: 26rpx;
  color: var(--gov-text-secondary);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.load-more {
  text-align: center;
  padding: 32rpx;
  font-size: 28rpx;
  color: var(--gov-primary);
}

.loading-more {
  text-align: center;
  padding: 24rpx;
  font-size: 26rpx;
  color: var(--gov-text-muted);
}

.filter-row {
  margin-bottom: 16rpx;
}

.phone-input {
  background: var(--gov-card);
  border-radius: var(--gov-radius);
  padding: 0 24rpx;
  height: 72rpx;
  font-size: 28rpx;
  border: 1rpx solid var(--gov-border);
}

.type-row {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.type-pill {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  background: var(--gov-card);
  border-radius: var(--gov-radius);
  font-size: 24rpx;
  color: var(--gov-text-secondary);
  border: 1rpx solid var(--gov-border);
}

.type-pill.active {
  background: var(--gov-primary);
  color: #fff;
  border-color: var(--gov-primary);
}
