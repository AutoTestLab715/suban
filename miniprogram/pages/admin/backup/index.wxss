page {
  background: var(--gov-bg);
  min-height: 100vh;
}

.page {
  padding: 24rpx 24rpx 80rpx;
}

.intro {
  background: var(--gov-card);
  border-radius: var(--gov-radius-lg);
  padding: 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--gov-border);
  box-shadow: var(--gov-shadow);
}

.intro-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gov-text);
  margin-bottom: 8rpx;
  padding-left: 16rpx;
  border-left: 4rpx solid var(--gov-primary);
}

.intro-desc {
  font-size: 26rpx;
  color: var(--gov-text-secondary);
  line-height: 1.5;
}

.backup-btn {
  background: var(--gov-primary);
  color: #fff;
  border-radius: var(--gov-radius);
  margin-bottom: 24rpx;
  font-size: 30rpx;
  letter-spacing: 2rpx;
}

.loading,
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: var(--gov-text-muted);
  font-size: 28rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card {
  background: var(--gov-card);
  border-radius: var(--gov-radius-lg);
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--gov-border);
  box-shadow: var(--gov-shadow);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.card-time {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--gov-text);
}

.card-tag {
  font-size: 22rpx;
  color: var(--gov-text-secondary);
  background: var(--gov-primary-light);
  padding: 4rpx 12rpx;
  border-radius: var(--gov-radius);
  border: 1rpx solid #b8d4f0;
}

.card-meta {
  font-size: 26rpx;
  color: var(--gov-text-secondary);
  margin-bottom: 16rpx;
}

.card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.card-action {
  font-size: 26rpx;
  color: var(--gov-primary);
  padding: 8rpx 0;
}

.card-action.primary {
  font-weight: 600;
}

.card-action.subtle {
  color: var(--gov-text-muted);
}

.card-action.disabled {
  color: var(--gov-text-muted);
}
