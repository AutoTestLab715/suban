<view class="page">
  <nav-bar title="网页登录确认" showBack="{{true}}" showAccount="{{false}}" backUrl="/pages/admin/index/index" />

  <view class="card">
    <view class="title">确认登录网页管理后台</view>
    <view class="desc">请确认是您本人在电脑浏览器上发起的登录请求。</view>
    <view wx:if="{{userName}}" class="user">当前账号：{{userName}}</view>

    <view wx:if="{{loading}}" class="status">加载中...</view>
    <view wx:elif="{{done}}" class="status success">已确认，请返回电脑查看</view>
    <view wx:elif="{{errorMsg && !pendingList.length}}" class="status error">{{errorMsg}}</view>

    <view wx:elif="{{pendingList.length}}" class="pending-list">
      <view class="pending-title">待确认的网页登录</view>
      <view class="pending-item" wx:for="{{pendingList}}" wx:key="sessionId">
        <view class="pending-info">
          <view class="pending-code">验证码 {{item.shortCode}}</view>
          <view class="pending-time">来自网页后台</view>
        </view>
        <button class="btn confirm sm" bindtap="onConfirmItem" data-id="{{item.sessionId}}">确认</button>
      </view>
    </view>

    <view wx:elif="{{sessionId}}" class="single-confirm">
      <view wx:if="{{shortCode}}" class="code-display">验证码 {{shortCode}}</view>
      <button class="btn confirm" bindtap="onConfirm" loading="{{confirming}}">确认登录</button>
      <button class="btn cancel" bindtap="onCancel">取消</button>
    </view>

    <view wx:else class="manual-box">
      <view class="manual-title">输入网页上的 6 位验证码</view>
      <input class="code-input" type="number" maxlength="6" placeholder="请输入验证码" value="{{inputCode}}" bindinput="onCodeInput" />
      <button class="btn confirm" bindtap="onConfirmByCode" loading="{{confirming}}">确认登录</button>
    </view>
  </view>
</view>
