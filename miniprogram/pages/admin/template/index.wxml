<view class="page">
  <nav-bar title="表单配置" showBack="{{true}}" showAccount="{{false}}" backUrl="/pages/admin/index/index" />

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <block wx:else>
    <view class="quick-links">
      <view class="quick-link" bindtap="goFields">字段管理 →</view>
      <view class="quick-link" bindtap="goStats">数据统计 →</view>
      <view class="quick-link" bindtap="goShare">分享表单 →</view>
    </view>

    <view class="section">
      <view class="section-title">基本信息</view>
      <view class="form-card">
        <view class="form-item">
          <view class="label">表单标题</view>
          <input class="input" value="{{form.title}}" bindinput="onInput" data-field="title" placeholder="表单标题" />
        </view>
        <view class="form-item">
          <view class="label">首页入口</view>
          <picker mode="selector" range="{{homeServiceOptions}}" range-key="label" value="{{homeServiceIndex}}" bindchange="onHomeServiceChange">
            <view class="picker-val">{{homeServiceOptions[homeServiceIndex].label}}</view>
          </picker>
          <view class="hint">绑定后，首页对应业务名称会跟随本表单标题变化</view>
        </view>
        <view class="form-item">
          <view class="label">表单描述</view>
          <textarea class="textarea" value="{{form.description}}" bindinput="onInput" data-field="description" placeholder="填写说明" auto-height />
        </view>
        <view class="form-item">
          <view class="label">主题色</view>
          <input class="input" value="{{form.themeColor}}" bindinput="onInput" data-field="themeColor" placeholder="#0d4a9c" />
        </view>
        <view class="form-item">
          <view class="label">封面图</view>
          <view class="image-picker">
            <image wx:if="{{form.coverImage}}" class="preview-image wide" src="{{form.coverImage}}" mode="aspectFill" />
            <view wx:else class="image-placeholder" bindtap="uploadSettingImage" data-field="coverImage">+ 上传封面</view>
            <view wx:if="{{form.coverImage}}" class="image-actions">
              <text bindtap="uploadSettingImage" data-field="coverImage">更换</text>
              <text bindtap="onRemoveSettingImage" data-field="coverImage">移除</text>
            </view>
          </view>
        </view>
        <view class="form-item">
          <view class="label">Logo</view>
          <view class="image-picker">
            <image wx:if="{{form.logoImage}}" class="preview-image square" src="{{form.logoImage}}" mode="aspectFill" />
            <view wx:else class="image-placeholder square" bindtap="uploadSettingImage" data-field="logoImage">+ Logo</view>
            <view wx:if="{{form.logoImage}}" class="image-actions">
              <text bindtap="uploadSettingImage" data-field="logoImage">更换</text>
              <text bindtap="onRemoveSettingImage" data-field="logoImage">移除</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">访问控制</view>
      <view class="form-card">
        <view class="form-item">
          <view class="label">访问方式</view>
          <picker mode="selector" range="{{accessModeOptions}}" range-key="label" value="{{accessModeIndex}}" bindchange="onAccessModeChange">
            <view class="picker-val">{{accessModeOptions[accessModeIndex].label}}</view>
          </picker>
        </view>
        <view class="form-item" wx:if="{{form.accessMode === 'share_only'}}">
          <view class="label">拒绝提示语</view>
          <input class="input" value="{{form.shareOnlyMsg}}" bindinput="onInput" data-field="shareOnlyMsg" placeholder="非分享入口进入时的提示" />
        </view>
        <view class="form-item" wx:if="{{form.accessMode === 'friend_only'}}">
          <view class="label">好友私聊拒绝提示</view>
          <input class="input" value="{{form.friendOnlyMsg}}" bindinput="onInput" data-field="friendOnlyMsg" placeholder="非好友私聊分享进入时的提示" />
        </view>
        <view class="form-item" wx:if="{{form.accessMode === 'group_only'}}">
          <view class="label">群聊拒绝提示</view>
          <input class="input" value="{{form.groupOnlyMsg}}" bindinput="onInput" data-field="groupOnlyMsg" placeholder="非群聊入口进入时的提示" />
        </view>
        <view class="form-item row">
          <view class="label">OpenID 白名单</view>
          <switch checked="{{form.openidWhitelistEnabled}}" bindchange="onSwitchChange" data-field="openidWhitelistEnabled" color="#0d4a9c" />
        </view>
        <view class="form-item" wx:if="{{form.openidWhitelistEnabled}}">
          <view class="label">OpenID 列表（每行一个）</view>
          <textarea class="textarea" value="{{form.openidWhitelist}}" bindinput="onInput" data-field="openidWhitelist" placeholder="从用户资料或日志获取 openid" auto-height />
        </view>
        <view class="form-item" wx:if="{{form.openidWhitelistEnabled}}">
          <view class="label">拒绝提示语</view>
          <input class="input" value="{{form.openidWhitelistDenyMsg}}" bindinput="onInput" data-field="openidWhitelistDenyMsg" />
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">提交规则</view>
      <view class="form-card">
        <view class="form-item">
          <view class="label">填写频次</view>
          <picker mode="selector" range="{{submitLimitOptions}}" range-key="label" value="{{submitLimitIndex}}" bindchange="onLimitChange">
            <view class="picker-val">{{submitLimitOptions[submitLimitIndex].label}}</view>
          </picker>
        </view>
        <view class="form-item row">
          <view class="label">允许修改已提交内容</view>
          <switch checked="{{form.allowEditSubmission}}" bindchange="onSwitchChange" data-field="allowEditSubmission" color="#0c3d7a" />
        </view>
        <view class="form-tip">开启后，用户可在「我的提交」中修改待处理/已处理的记录</view>
        <view class="form-item">
          <view class="label">开放日期</view>
          <picker mode="date" value="{{form.openAt}}" bindchange="onDateChange" data-field="openAt">
            <view class="picker-val">{{form.openAt || '不限（立即开放）'}}</view>
          </picker>
        </view>
        <view class="form-item">
          <view class="label">截止日期</view>
          <picker mode="date" value="{{form.closeAt}}" bindchange="onDateChange" data-field="closeAt">
            <view class="picker-val">{{form.closeAt || '不限（长期有效）'}}</view>
          </picker>
        </view>
        <view class="form-item">
          <view class="label">未开放提示</view>
          <input class="input" value="{{form.notOpenMsg}}" bindinput="onInput" data-field="notOpenMsg" placeholder="表单尚未开放时的提示" />
        </view>
        <view class="form-item">
          <view class="label">已截止提示</view>
          <input class="input" value="{{form.closedMsg}}" bindinput="onInput" data-field="closedMsg" placeholder="表单截止后的提示" />
        </view>
        <view class="form-item row">
          <view class="label">重复提交检测</view>
          <switch checked="{{form.duplicateCheckEnabled}}" bindchange="onSwitchChange" data-field="duplicateCheckEnabled" color="#0d4a9c" />
        </view>
        <view class="form-item" wx:if="{{form.duplicateCheckEnabled}}">
          <view class="label">检测窗口（分钟）</view>
          <input class="input" type="number" value="{{form.duplicateWindowMinutes}}" bindinput="onInput" data-field="duplicateWindowMinutes" placeholder="默认 5" />
        </view>
        <view class="form-item" wx:if="{{form.duplicateCheckEnabled}}">
          <view class="label">重复提交提示语</view>
          <input class="input" value="{{form.duplicateMsg}}" bindinput="onInput" data-field="duplicateMsg" placeholder="请勿重复提交相同内容" />
        </view>
        <view class="form-item">
          <view class="label">访问密码</view>
          <input class="input" password value="{{form.accessPassword}}" bindinput="onInput" data-field="accessPassword" placeholder="留空则公开访问" />
          <view class="form-tip">已设置时显示 ********；直接保存不会更改密码，清空后保存会取消密码。</view>
        </view>
        <view class="form-item">
          <view class="label">名额上限</view>
          <input class="input" type="number" value="{{form.maxSubmissions}}" bindinput="onInput" data-field="maxSubmissions" placeholder="0 表示不限" />
        </view>
        <view class="form-item">
          <view class="label">名额已满提示</view>
          <input class="input" value="{{form.quotaFullMsg}}" bindinput="onInput" data-field="quotaFullMsg" placeholder="名额已满时的提示语" />
        </view>
        <view class="form-item">
          <view class="label">报名费用（元）</view>
          <input class="input" type="digit" value="{{form.paymentAmount}}" bindinput="onInput" data-field="paymentAmount" placeholder="0 表示免费" />
        </view>
        <view class="form-item">
          <view class="label">微信支付子商户号</view>
          <input class="input" value="{{form.paymentMchId}}" bindinput="onInput" data-field="paymentMchId" placeholder="开通云支付后填写 subMchId" />
        </view>
        <view class="form-item row">
          <view class="label">手机号白名单</view>
          <switch checked="{{form.whitelistEnabled}}" bindchange="onSwitchChange" data-field="whitelistEnabled" color="#0d4a9c" />
        </view>
        <view class="form-item" wx:if="{{form.whitelistEnabled}}">
          <view class="label">白名单号码（每行一个）</view>
          <textarea class="textarea" value="{{form.phoneWhitelist}}" bindinput="onInput" data-field="phoneWhitelist" placeholder="13800138000&#10;13900139000" auto-height />
        </view>
        <view class="form-item" wx:if="{{form.whitelistEnabled}}">
          <view class="label">拒绝提示语</view>
          <input class="input" value="{{form.whitelistDenyMsg}}" bindinput="onInput" data-field="whitelistDenyMsg" placeholder="不在白名单时的提示" />
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">隐私与按钮</view>
      <view class="form-card">
        <view class="form-item row">
          <view class="label">提交前需同意隐私协议</view>
          <switch checked="{{form.needPrivacy}}" bindchange="onSwitchChange" data-field="needPrivacy" color="#0d4a9c" />
        </view>
        <view class="form-item">
          <view class="label">隐私标题</view>
          <input class="input" value="{{form.privacyTitle}}" bindinput="onInput" data-field="privacyTitle" />
        </view>
        <view class="form-item">
          <view class="label">隐私内容</view>
          <textarea class="textarea" value="{{form.privacyText}}" bindinput="onInput" data-field="privacyText" auto-height />
        </view>
        <view class="form-item">
          <view class="label">提交按钮文字</view>
          <input class="input" value="{{form.submitButtonText}}" bindinput="onInput" data-field="submitButtonText" />
        </view>
        <view class="form-item">
          <view class="label">底部说明</view>
          <textarea class="textarea" value="{{form.footerText}}" bindinput="onInput" data-field="footerText" placeholder="表单底部展示的补充说明" auto-height />
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">上传限制</view>
      <view class="form-card">
        <view class="form-item">
          <view class="label">单文件大小上限（MB）</view>
          <input class="input" type="digit" value="{{form.uploadMaxSizeMB}}" bindinput="onInput" data-field="uploadMaxSizeMB" placeholder="10" />
        </view>
        <view class="form-item">
          <view class="label">允许的文件扩展名</view>
          <input class="input" value="{{form.uploadAllowedExts}}" bindinput="onInput" data-field="uploadAllowedExts" placeholder="jpg,png,pdf,doc,docx" />
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">分节问卷（逻辑跳转）</view>
      <view class="form-card">
        <view class="form-item row">
          <view class="label">启用分节填写</view>
          <switch checked="{{form.pagedForm}}" bindchange="onSwitchChange" data-field="pagedForm" color="#0d4a9c" />
        </view>
        <view class="form-item" wx:if="{{form.pagedForm}}">
          <view class="label">分节配置（JSON）</view>
          <textarea class="textarea code" value="{{form.sectionsText}}" bindinput="onInput" data-field="sectionsText" placeholder='[{"id":"s1","title":"基本信息"},{"id":"s2","title":"详情"}]' auto-height />
        </view>
        <view class="form-tip" wx:if="{{form.pagedForm}}">在字段编辑器中为字段指定所属分节，并配置选项跳转规则 jumpRules</view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">短信通知</view>
      <view class="form-card">
        <view class="form-item row">
          <view class="label">启用短信通知</view>
          <switch checked="{{form.smsEnabled}}" bindchange="onSwitchChange" data-field="smsEnabled" color="#0d4a9c" />
        </view>
        <block wx:if="{{form.smsEnabled}}">
          <view class="form-item row">
            <view class="label">日报也发短信</view>
            <switch checked="{{form.smsDigestEnabled}}" bindchange="onSwitchChange" data-field="smsDigestEnabled" color="#0d4a9c" />
          </view>
          <view class="form-item row">
            <view class="label">状态变更短信通知用户</view>
            <switch checked="{{form.smsSubmitterEnabled}}" bindchange="onSwitchChange" data-field="smsSubmitterEnabled" color="#0d4a9c" />
          </view>
          <view class="form-item">
            <view class="label">Webhook 地址（可选）</view>
            <input class="input" value="{{form.smsWebhookUrl}}" bindinput="onInput" data-field="smsWebhookUrl" placeholder="https://your-server.com/sms/send" />
          </view>
          <view class="form-item">
            <view class="label">Webhook 密钥</view>
            <input class="input" value="{{form.smsSecret}}" bindinput="onInput" data-field="smsSecret" placeholder="可选" />
          </view>
          <view class="form-item">
            <view class="label">通知手机号（每行一个）</view>
            <textarea class="textarea" value="{{form.smsNotifyPhones}}" bindinput="onInput" data-field="smsNotifyPhones" placeholder="13800138000" auto-height />
          </view>
          <view class="form-item row">
            <view class="label">腾讯云短信</view>
            <switch checked="{{form.tencentSmsEnabled}}" bindchange="onSwitchChange" data-field="tencentSmsEnabled" color="#0d4a9c" />
          </view>
          <block wx:if="{{form.tencentSmsEnabled}}">
            <view class="form-item">
              <view class="label">SecretId / SecretKey</view>
              <input class="input" value="{{form.tencentSecretId}}" bindinput="onInput" data-field="tencentSecretId" placeholder="SecretId" />
              <input class="input" style="margin-top:12rpx" password value="{{form.tencentSecretKey}}" bindinput="onInput" data-field="tencentSecretKey" placeholder="SecretKey" />
            </view>
            <view class="form-item">
              <view class="label">SmsSdkAppId / 签名 / 模板ID</view>
              <input class="input" value="{{form.tencentSmsAppId}}" bindinput="onInput" data-field="tencentSmsAppId" placeholder="SmsSdkAppId" />
              <input class="input" style="margin-top:12rpx" value="{{form.tencentSmsSign}}" bindinput="onInput" data-field="tencentSmsSign" placeholder="短信签名" />
              <input class="input" style="margin-top:12rpx" value="{{form.tencentSmsTemplateId}}" bindinput="onInput" data-field="tencentSmsTemplateId" placeholder="模板 ID" />
            </view>
          </block>
        </block>
      </view>
    </view>

    <view class="section">
      <view class="section-title">公众号关联</view>
      <view class="form-card">
        <view class="form-item">
          <view class="label">公众号名称</view>
          <input class="input" value="{{form.oaName}}" bindinput="onInput" data-field="oaName" placeholder="如：XX官方服务号" />
        </view>
        <view class="form-item">
          <view class="label">文章/活动链接</view>
          <input class="input" value="{{form.oaArticleUrl}}" bindinput="onInput" data-field="oaArticleUrl" placeholder="https://mp.weixin.qq.com/s/..." />
        </view>
        <view class="form-tip">填写后表单底部将展示公众号入口（需配置业务域名方可 web-view 打开）</view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">防刷与安全</view>
      <view class="form-card">
        <view class="form-item row">
          <view class="label">提交前验证码</view>
          <switch checked="{{form.captchaEnabled}}" bindchange="onSwitchChange" data-field="captchaEnabled" color="#0d4a9c" />
        </view>
        <view class="form-item">
          <view class="label">每小时提交上限（0=不限）</view>
          <input class="input" type="number" value="{{form.maxSubmitsPerHour}}" bindinput="onInput" data-field="maxSubmitsPerHour" placeholder="如 5" />
        </view>
        <view class="form-item">
          <view class="label">频率限制提示语</view>
          <input class="input" value="{{form.rateLimitMsg}}" bindinput="onInput" data-field="rateLimitMsg" placeholder="提交过于频繁时的提示" />
        </view>
        <view class="form-item">
          <view class="label">异常告警阈值（1小时内次数）</view>
          <input class="input" type="number" value="{{form.anomalyThreshold}}" bindinput="onInput" data-field="anomalyThreshold" placeholder="默认 3" />
        </view>
        <view class="form-item row">
          <view class="label">设备指纹限制</view>
          <switch checked="{{form.deviceLimitEnabled}}" bindchange="onSwitchChange" data-field="deviceLimitEnabled" color="#0d4a9c" />
        </view>
        <view class="form-item" wx:if="{{form.deviceLimitEnabled}}">
          <view class="label">每设备每日上限</view>
          <input class="input" type="number" value="{{form.maxSubmitsPerDevice}}" bindinput="onInput" data-field="maxSubmitsPerDevice" placeholder="默认 3" />
        </view>
        <view class="form-item" wx:if="{{form.deviceLimitEnabled}}">
          <view class="label">设备限制提示语</view>
          <input class="input" value="{{form.deviceLimitMsg}}" bindinput="onInput" data-field="deviceLimitMsg" placeholder="该设备今日提交次数已达上限" />
        </view>
        <view class="form-item row">
          <view class="label">IP 频率限制</view>
          <switch checked="{{form.ipLimitEnabled}}" bindchange="onSwitchChange" data-field="ipLimitEnabled" color="#0d4a9c" />
        </view>
        <view class="form-item" wx:if="{{form.ipLimitEnabled}}">
          <view class="label">每 IP 每小时上限</view>
          <input class="input" type="number" value="{{form.maxSubmitsPerIp}}" bindinput="onInput" data-field="maxSubmitsPerIp" placeholder="默认 10" />
        </view>
        <view class="form-item" wx:if="{{form.ipLimitEnabled}}">
          <view class="label">IP 限制提示语</view>
          <input class="input" value="{{form.ipLimitMsg}}" bindinput="onInput" data-field="ipLimitMsg" placeholder="当前网络提交过于频繁" />
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">运营日报</view>
      <view class="form-card">
        <view class="form-item row">
          <view class="label">自动推送摘要</view>
          <switch checked="{{form.autoDigestEnabled}}" bindchange="onSwitchChange" data-field="autoDigestEnabled" color="#0d4a9c" />
        </view>
        <view class="form-item" wx:if="{{form.autoDigestEnabled}}">
          <view class="label">推送时间（整点）</view>
          <picker mode="selector" range="{{digestHourOptions}}" value="{{digestHourIndex}}" bindchange="onDigestHourChange">
            <view class="picker-val">{{digestHourOptions[digestHourIndex]}}</view>
          </picker>
        </view>
        <view class="form-tip">需管理员在「分享」页订阅消息；也可在数据统计页手动推送</view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">数据备份</view>
      <view class="form-card">
        <view class="form-item row">
          <view class="label">每天 3:00 自动备份</view>
          <switch checked="{{form.autoBackupEnabled}}" bindchange="onSwitchChange" data-field="autoBackupEnabled" color="#0d4a9c" />
        </view>
        <view class="form-tip">备份文件保存在云存储，可在「数据备份」页查看与手动备份</view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">活动签到</view>
      <view class="form-card">
        <view class="form-item row">
          <view class="label">启用签到凭证码</view>
          <switch checked="{{form.checkinEnabled}}" bindchange="onSwitchChange" data-field="checkinEnabled" color="#0d4a9c" />
        </view>
        <view class="form-tip">开启后，用户提交成功将获得 6 位签到码，管理员可在「签到核销」页核验</view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">提交者通知</view>
      <view class="form-card">
        <view class="form-item row">
          <view class="label">处理结果通知</view>
          <switch checked="{{form.submitterNotifyEnabled}}" bindchange="onSwitchChange" data-field="submitterNotifyEnabled" color="#0d4a9c" />
        </view>
        <view class="form-item">
          <view class="label">订阅消息模板 ID</view>
          <input class="input" value="{{form.submitterNotifyTemplateId}}" bindinput="onInput" data-field="submitterNotifyTemplateId" placeholder="字段需含 thing1、time2、thing3" />
        </view>
        <view class="form-tip">用户提交时会请求授权，管理员标记已处理/已拒绝后自动推送</view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">提交成功页</view>
      <view class="form-card">
        <view class="form-item">
          <view class="label">成功标题</view>
          <input class="input" value="{{form.successTitle}}" bindinput="onInput" data-field="successTitle" />
        </view>
        <view class="form-item">
          <view class="label">成功描述</view>
          <textarea class="textarea" value="{{form.successDesc}}" bindinput="onInput" data-field="successDesc" auto-height />
        </view>
        <view class="form-item">
          <view class="label">提交后跳转</view>
          <picker mode="selector" range="{{['不跳转','其他小程序','网页链接']}}" value="{{form.successRedirectType === 'miniprogram' ? 1 : form.successRedirectType === 'web' ? 2 : 0}}" bindchange="onRedirectTypeChange">
            <view class="picker-val">{{form.successRedirectType === 'miniprogram' ? '其他小程序' : form.successRedirectType === 'web' ? '网页链接' : '不跳转'}}</view>
          </picker>
        </view>
        <view class="form-item" wx:if="{{form.successRedirectType === 'miniprogram'}}">
          <view class="label">小程序 AppID</view>
          <input class="input" value="{{form.successRedirectAppId}}" bindinput="onInput" data-field="successRedirectAppId" />
        </view>
        <view class="form-item" wx:if="{{form.successRedirectType === 'miniprogram'}}">
          <view class="label">跳转路径</view>
          <input class="input" value="{{form.successRedirectPath}}" bindinput="onInput" data-field="successRedirectPath" placeholder="pages/index/index" />
        </view>
        <view class="form-item" wx:if="{{form.successRedirectType === 'web'}}">
          <view class="label">网页 URL</view>
          <input class="input" value="{{form.successRedirectUrl}}" bindinput="onInput" data-field="successRedirectUrl" placeholder="https://" />
        </view>
      </view>
    </view>

    <button class="save-btn" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">保存配置</button>
  </block>
</view>
