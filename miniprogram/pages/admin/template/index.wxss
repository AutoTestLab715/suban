page {
  background: #f1f5f9;
  min-height: 100vh;
}

.page {
  padding: 24rpx 24rpx 80rpx;
}

.quick-links {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.quick-link {
  flex: 1;
  min-width: 200rpx;
  text-align: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #0d4a9c;
  border: 1rpx solid #e2e8f0;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #94a3b8;
}

.section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
  padding-left: 8rpx;
}

.form-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  font-size: 26rpx;
  color: #475569;
  margin-bottom: 12rpx;
}

.form-item.row .label {
  margin-bottom: 0;
}

.input,
.textarea,
.picker-val {
  font-size: 28rpx;
  color: #0f172a;
}

.textarea {
  width: 100%;
  min-height: 100rpx;
  line-height: 1.6;
}

.picker-val {
  color: #334155;
}

.hint {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 1.4;
}

.save-btn {
  margin-top: 16rpx;
  background: #0d4a9c;
  color: #fff;
  border-radius: 16rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
  border: none;
}

.image-picker {
  margin-top: 8rpx;
}

.preview-image.wide {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
}

.preview-image.square,
.image-placeholder.square {
  width: 120rpx;
  height: 120rpx;
}

.image-placeholder {
  width: 100%;
  height: 200rpx;
  background: #f8fafc;
  border: 2rpx dashed #cbd5e1;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
  font-size: 26rpx;
}

.image-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #2563eb;
}

.form-tip {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.6;
  padding: 12rpx 0 0;
}

.form-link {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #0c3d7a;
  font-weight: 600;
}
