page {
  background: #f1f5f9;
  min-height: 100vh;
}

.page {
  padding: 24rpx 24rpx 80rpx;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #94a3b8;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.section-actions {
  display: flex;
  gap: 24rpx;
  font-size: 26rpx;
  color: #2563eb;
}

.field-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.field-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  color: #334155;
}

.format-row {
  display: flex;
  gap: 40rpx;
}

.format-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #334155;
}

.export-btn {
  background: #0d4a9c;
  color: #fff;
  border-radius: 16rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
  border: none;
  margin-bottom: 16rpx;
}

.export-btn.secondary {
  background: #fff;
  color: #0d4a9c;
  border: 2rpx solid #e2e8f0;
}

.export-tip {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.5;
  padding: 0 8rpx;
}
