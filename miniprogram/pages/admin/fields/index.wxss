page {
  background: #f1f5f9;
  min-height: 100vh;
}

.page {
  padding: 24rpx 24rpx 80rpx;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #94a3b8;
}

.tip {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
  flex: 1;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.field-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
  position: relative;
}

.field-list.dragging-active {
  overflow: visible;
}

.field-card {
  position: relative;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid transparent;
  will-change: transform;
}

.field-list.dragging-active .field-card {
  transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.25s ease, opacity 0.25s ease, border-color 0.2s ease;
}

.field-list.dragging-active .field-card.dragging {
  transition: box-shadow 0.2s ease, border-color 0.2s ease;
}

.field-card.dragging {
  box-shadow:
    0 24rpx 56rpx rgba(13, 74, 156, 0.28),
    0 8rpx 20rpx rgba(15, 23, 42, 0.12);
  border-color: #0d4a9c;
  opacity: 1;
}

.field-card.shifted {
  opacity: 0.82;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.08);
}

.field-card.drop-target {
  border-color: #60a5fa;
  background: linear-gradient(180deg, #f8fbff 0%, #eff6ff 100%);
}

.drag-handle {
  font-size: 36rpx;
  color: #94a3b8;
  line-height: 1;
  padding-top: 4rpx;
  flex-shrink: 0;
}

.field-main {
  flex: 1;
  min-width: 0;
}

.field-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.field-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #f1f5f9;
  color: #64748b;
}

.tag.required {
  background: #fee2e2;
  color: #dc2626;
}

.tag.logic {
  background: #dbeafe;
  color: #2563eb;
}

.field-logic {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.field-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: auto;
}

.action {
  width: 56rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #f8fafc;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.action.edit {
  width: auto;
  padding: 0 16rpx;
  color: #0d4a9c;
}

.action.del {
  width: auto;
  padding: 0 16rpx;
  color: #ef4444;
}

.add-btn {
  background: #fff;
  color: #0d4a9c;
  border: 2rpx dashed #cbd5e1;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.save-btn {
  background: #0d4a9c;
  color: #fff;
  border-radius: 16rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
  border: none;
}

.editor-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.editor-panel {
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}

.editor-title {
  font-size: 32rpx;
  font-weight: 600;
  padding: 32rpx 32rpx 16rpx;
  color: #0f172a;
}

.editor-body {
  flex: 1;
  max-height: 60vh;
  padding: 0 32rpx;
}

.editor-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.editor-item.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.editor-label {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.editor-item.row .editor-label {
  margin-bottom: 0;
}

.editor-input,
.editor-picker,
.editor-textarea {
  font-size: 28rpx;
  color: #0f172a;
}

.editor-textarea {
  width: 100%;
  min-height: 120rpx;
}

.editor-section {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
  padding: 24rpx 0 8rpx;
}

.editor-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx 48rpx;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
}

.btn-cancel {
  background: #f1f5f9;
  color: #64748b;
}

.btn-confirm {
  background: #0d4a9c;
  color: #fff;
}
