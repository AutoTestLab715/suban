page {
  background: #f0f2f5;
  min-height: 100vh;
}

.page {
  padding: 24rpx 24rpx 60rpx;
}

.loading-page-wrap {
  min-height: 100vh;
  background: #f1f5f9;
}

.loading-page {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.status-tag {
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.status-pending {
  background: #fff7e6;
  color: #fa8c16;
}

.status-processed {
  background: #f6ffed;
  color: #52c41a;
}

.status-rejected {
  background: #fef2f2;
  color: #ef4444;
}

.status-time {
  font-size: 24rpx;
  color: #999;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.edited-tag {
  font-size: 22rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.form-no-card {
  background: #f0f6fc;
  border: 1rpx solid #c5d9ef;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.form-no-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.form-no-code {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--gov-primary, #1a5fb4);
  letter-spacing: 2rpx;
  word-break: break-all;
}

.info-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.checkin-card {
  background: #eff6ff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
}

.checkin-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.checkin-code {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: #0d4a9c;
}

.checkin-status {
  font-size: 24rpx;
  color: #2563eb;
  margin-top: 8rpx;
}

.refund-card {
  background: #fff7ed;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #fed7aa;
}

.refund-card.muted {
  background: #f8fafc;
  border-color: #e2e8f0;
}

.refund-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #c2410c;
  margin-bottom: 8rpx;
}

.refund-card.muted .refund-label {
  color: #64748b;
}

.refund-reason {
  font-size: 26rpx;
  color: #475569;
  margin-bottom: 16rpx;
}

.detail-signature {
  width: 100%;
  height: 160rpx;
  background: #f8fafc;
  border-radius: 8rpx;
}

.remark-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.remark-label {
  font-size: 28rpx;
  color: #475569;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.grade-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.grade-star {
  font-size: 44rpx;
  color: #cbd5e1;
}

.grade-star.active {
  color: #f59e0b;
}

.remark-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #334155;
  line-height: 1.6;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.remark-save {
  margin-top: 16rpx;
  background: #0d4a9c;
  color: #fff;
  border: none;
  border-radius: 8rpx;
}

.info-row {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row.column {
  flex-direction: column;
  align-items: flex-start;
}

.info-label {
  font-size: 28rpx;
  color: #888;
  flex-shrink: 0;
}

.info-value {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.info-value.phone {
  color: #667eea;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.detail-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
}

.file-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
  width: 100%;
}

.file-link {
  font-size: 28rpx;
  color: #2563eb;
  padding: 16rpx 20rpx;
  background: #eff6ff;
  border-radius: 12rpx;
}

.action-btn.edit {
  background: #fff;
  color: #0d4a9c;
  border: 1rpx solid #0d4a9c;
}

.action-btn.reject {
  background: #fff;
  color: #ef4444;
  border: 1rpx solid #fecaca;
}

.info-content {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 1.7;
  word-break: break-all;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.action-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 12rpx;
  height: 80rpx;
  line-height: 80rpx;
  border: none;
  padding: 0;
}

.action-btn.call {
  background: #667eea;
  color: #fff;
}

.action-btn.copy {
  background: #fff;
  color: #667eea;
  border: 1rpx solid #667eea;
}

.action-btn.primary {
  background: #52c41a;
  color: #fff;
}

.action-btn.secondary {
  background: #fa8c16;
  color: #fff;
}

.action-btn.danger {
  background: #fff;
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
}
