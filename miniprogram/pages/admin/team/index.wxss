page {
  background: #f1f5f9;
  min-height: 100vh;
}

.page {
  padding: 24rpx 24rpx 80rpx;
}

.tip {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #94a3b8;
}

.member-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e2e8f0;
}

.member-info {
  flex: 1;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

.role {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.role-picker {
  font-size: 26rpx;
  color: #2563eb;
  padding: 12rpx 20rpx;
  background: #eff6ff;
  border-radius: 8rpx;
}
