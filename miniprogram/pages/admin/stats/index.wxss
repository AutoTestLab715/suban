page {
  background: #f1f5f9;
  min-height: 100vh;
}

.page {
  padding: 24rpx 24rpx 80rpx;
}

.loading,
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #94a3b8;
  font-size: 28rpx;
}

.summary-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.summary-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx 20rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.summary-card.highlight {
  background: #0d4a9c;
}

.summary-card.highlight .summary-num,
.summary-card.highlight .summary-label {
  color: #fff;
}

.summary-card.warn .summary-num {
  color: #fa8c16;
}

.summary-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 4rpx;
}

.summary-label {
  font-size: 24rpx;
  color: #94a3b8;
}

.chart-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.chart-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 24rpx;
}

.bar-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 280rpx;
  gap: 8rpx;
}

.bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.bar-value {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 8rpx;
  min-height: 28rpx;
}

.bar-track {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar-fill {
  width: 70%;
  min-height: 4rpx;
  background: linear-gradient(180deg, #334155 0%, #0d4a9c 100%);
  border-radius: 8rpx 8rpx 0 0;
  transition: height 0.3s;
}

.bar-label {
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 12rpx;
}

.type-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.type-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.type-name {
  font-size: 26rpx;
  color: #334155;
}

.type-count {
  font-size: 26rpx;
  color: #64748b;
  font-weight: 600;
}

.type-track {
  height: 16rpx;
  background: #f1f5f9;
  border-radius: 8rpx;
  overflow: hidden;
}

.type-fill {
  height: 100%;
  background: #0d4a9c;
  border-radius: 8rpx;
  min-width: 4rpx;
}

.pie-wrap {
  display: flex;
  align-items: center;
  gap: 32rpx;
  flex-wrap: wrap;
}

.pie-chart {
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.pie-legend {
  flex: 1;
  min-width: 240rpx;
}

.legend-item {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  padding: 8rpx 0;
}

.legend-name {
  color: #334155;
}

.legend-count {
  color: #64748b;
  font-weight: 600;
}

.chart-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.copy-link {
  font-size: 26rpx;
  color: #2563eb;
  margin-left: 20rpx;
}

.copy-link.push {
  color: #059669;
}

.digest-actions {
  display: flex;
  align-items: center;
}

.digest-text {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.6;
  white-space: pre-wrap;
  background: #f8fafc;
  padding: 20rpx;
  border-radius: 12rpx;
}

.digest-warn {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #ea580c;
}

.digest-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.anomaly-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
  font-size: 26rpx;
}

.anomaly-reason {
  color: #ef4444;
}

.anomaly-meta {
  color: #64748b;
}

.field-stat {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.field-stat-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 8rpx;
}

.vote-item {
  padding: 10rpx 0 14rpx;
}

.vote-head {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  margin-bottom: 8rpx;
  color: #475569;
}

.vote-option {
  flex: 1;
  padding-right: 16rpx;
}

.vote-count {
  font-weight: 600;
  color: #0d4a9c;
  flex-shrink: 0;
}

.vote-track {
  height: 16rpx;
  background: #f1f5f9;
  border-radius: 8rpx;
  overflow: hidden;
}

.vote-fill {
  height: 100%;
  background: linear-gradient(90deg, #334155 0%, #0d4a9c 100%);
  border-radius: 8rpx;
  min-width: 4rpx;
  transition: width 0.3s;
}

.num-stats {
  font-size: 26rpx;
  color: #64748b;
}
