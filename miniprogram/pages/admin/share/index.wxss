page {
  background: #f1f5f9;
  min-height: 100vh;
}

.page {
  padding: 24rpx 24rpx 80rpx;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #94a3b8;
}

.poster-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.06);
  margin-bottom: 24rpx;
}

.poster-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 12rpx;
}

.poster-desc {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

.qr-wrap {
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qr-image {
  width: 360rpx;
  height: 360rpx;
}

.qr-loading {
  font-size: 26rpx;
  color: #94a3b8;
}

.poster-tip {
  font-size: 24rpx;
  color: #94a3b8;
}

.action-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 32rpx;
  flex-wrap: wrap;
}

.action-btn {
  flex: 1;
  min-width: 180rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  background: #fff;
  color: #334155;
  border: 1rpx solid #e2e8f0;
}

.action-btn.primary {
  background: #0d4a9c;
  color: #fff;
  border: none;
}

.section-title {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
  padding-left: 8rpx;
}

.notify-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}

.notify-tip {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.notify-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.notify-item.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.notify-label {
  font-size: 26rpx;
  color: #475569;
  margin-bottom: 12rpx;
}

.notify-item.row .notify-label {
  margin-bottom: 0;
}

.notify-input {
  font-size: 26rpx;
  color: #0f172a;
}

.notify-save,
.notify-sub {
  margin-top: 20rpx;
  width: 100%;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.notify-save {
  background: #f1f5f9;
  color: #475569;
  border: none;
}

.notify-link {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #0c3d7a;
  font-weight: 600;
  text-align: center;
}

.notify-sub {
  background: #0d4a9c;
  color: #fff;
  border: none;
}

.poster-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 375px;
  height: 560px;
}

.poster-preview {
  margin-bottom: 32rpx;
}

.poster-image {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.action-btn.full {
  width: 100%;
}
