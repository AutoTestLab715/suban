<view class="page">
  <nav-bar title="个人主页" showBack="{{false}}" showAccount="{{false}}" />

  <view wx:if="{{loading && !needLogin}}" class="loading">加载中...</view>

  <block wx:elif="{{needLogin}}">
    <view class="profile-guest">
      <view class="guest-avatar-wrap">
        <image class="guest-avatar" src="{{defaultAvatar}}" mode="aspectFill" />
      </view>
      <view class="guest-title">未登录</view>
      <view class="guest-desc">登录后可管理个人资料、查看提交记录</view>
      <button class="guest-login-btn" bindtap="goLoginTap">立即登录</button>
    </view>
  </block>

  <block wx:else>
    <view class="profile-header">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <view class="avatar-ring">
          <image class="avatar" src="{{form.avatarUrl || defaultAvatar}}" mode="aspectFill" />
        </view>
        <view class="avatar-tip">点击更换头像</view>
      </button>
      <view class="role-badge {{isAdmin ? 'admin' : ''}}">{{roleLabel}}</view>
      <view wx:if="{{adminRoleLabel}}" class="role-sub">{{adminRoleLabel}}</view>
    </view>

    <view class="form-card">
      <view class="form-item">
        <view class="form-label">昵称</view>
        <input
          class="form-input"
          type="nickname"
          placeholder="点击填写，可使用微信昵称"
          value="{{form.nickName}}"
          bindinput="onInput"
          bindblur="onNicknameBlur"
          data-field="nickName"
          maxlength="20"
        />
      </view>

      <view class="form-item">
        <view class="form-label">手机号</view>
        <input
          class="form-input"
          type="number"
          placeholder="登录后自动获取"
          value="{{form.phone}}"
          disabled="{{true}}"
          maxlength="11"
        />
      </view>

      <view class="form-item">
        <view class="form-label">邮箱</view>
        <input
          class="form-input"
          placeholder="选填"
          value="{{form.email}}"
          bindinput="onInput"
          data-field="email"
          maxlength="50"
        />
      </view>
    </view>

    <button class="save-btn" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">
      保存资料
    </button>

    <view wx:if="{{isAdmin}}" class="admin-actions">
      <button class="admin-btn" bindtap="goAdmin">进入管理后台</button>
      <button class="admin-btn secondary" bindtap="goUserHome">去用户端填表</button>
    </view>

    <view class="logout-section">
      <button class="logout-btn" bindtap="onLogout">退出登录</button>
    </view>
  </block>
</view>
