page {
  background: var(--gov-bg);
  min-height: 100vh;
}

.page {
  padding: 0 24rpx 80rpx;
}

.page-intro {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--gov-card);
  margin: 20rpx 0 24rpx;
  padding: 24rpx 24rpx;
  border-radius: var(--gov-radius-lg);
  border: 1rpx solid var(--gov-border);
  box-shadow: var(--gov-shadow);
}

.intro-bar {
  width: 6rpx;
  height: 64rpx;
  background: linear-gradient(180deg, #b8942e, #0c3d7a);
  border-radius: 3rpx;
  flex-shrink: 0;
}

.intro-content {
  flex: 1;
  min-width: 0;
}

.intro-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gov-text);
  letter-spacing: 2rpx;
  margin-bottom: 6rpx;
}

.intro-desc {
  font-size: 24rpx;
  color: var(--gov-text-muted);
}

.intro-link {
  font-size: 24rpx;
  color: var(--gov-primary);
  padding: 12rpx 20rpx;
  border: 1rpx solid var(--gov-primary);
  border-radius: var(--gov-radius);
  flex-shrink: 0;
}

.loading,
.empty {
  text-align: center;
  padding: 100rpx 0;
  color: var(--gov-text-muted);
  font-size: 28rpx;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 24rpx;
  border: 3rpx solid var(--gov-border);
  border-radius: var(--gov-radius);
  position: relative;
}

.empty-icon::before {
  content: "";
  position: absolute;
  top: 24rpx;
  left: 20rpx;
  right: 20rpx;
  height: 4rpx;
  background: var(--gov-border);
  box-shadow: 0 16rpx 0 var(--gov-border), 0 32rpx 0 var(--gov-border);
}

.empty-text {
  margin-bottom: 32rpx;
  color: var(--gov-text-secondary);
}

.empty-btn {
  display: inline-block;
  background: var(--gov-primary);
  color: #fff;
  font-size: 28rpx;
  padding: 0 48rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: var(--gov-radius);
  border: none;
  letter-spacing: 2rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.intro-link.active {
  background: var(--gov-primary);
  color: #fff;
}

.batch-bar {
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff5f5;
  border: 1rpx solid #f5c6cb;
  border-radius: var(--gov-radius-lg);
}

.batch-count {
  font-size: 26rpx;
  color: var(--gov-text);
  display: block;
  margin-bottom: 12rpx;
}

.batch-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.batch-btn {
  font-size: 24rpx;
  color: var(--gov-primary);
  background: var(--gov-primary-light);
  padding: 10rpx 20rpx;
  border-radius: var(--gov-radius);
  border: 1rpx solid #b8d4f0;
}

.batch-delete-btn {
  margin: 0;
  background: var(--gov-red);
  color: #fff;
  border: none;
  font-size: 24rpx;
  padding: 0 28rpx;
}

.card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: var(--gov-card);
  border-radius: var(--gov-radius-lg);
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--gov-border);
  box-shadow: var(--gov-shadow);
}

.card.selected {
  border-color: var(--gov-primary);
  box-shadow: 0 0 0 2rpx rgba(12, 61, 122, 0.12);
}

.card-body {
  flex: 1;
  min-width: 0;
}

.select-box {
  padding-top: 8rpx;
  flex-shrink: 0;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--gov-border);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  background: #fff;
}

.checkbox.checked {
  background: var(--gov-primary);
  border-color: var(--gov-primary);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--gov-border-light);
}

.card-header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-type {
  background: var(--gov-primary-light);
  color: var(--gov-primary);
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--gov-radius);
  border: 1rpx solid #b8d4f0;
}

.status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--gov-radius);
}

.status-pending {
  background: #fff8e6;
  color: var(--gov-warning);
}

.status-processed {
  background: #edf7f0;
  color: var(--gov-success);
}

.status-rejected {
  background: #fef2f2;
  color: var(--gov-red);
}

.status-unpaid {
  background: var(--gov-primary-light);
  color: var(--gov-primary);
}

.card-time {
  font-size: 22rpx;
  color: var(--gov-text-muted);
}

.card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gov-text);
  margin-bottom: 8rpx;
}

.card-form-no {
  font-size: 24rpx;
  color: var(--gov-primary);
  margin-bottom: 8rpx;
}

.card-voucher {
  font-size: 24rpx;
  color: var(--gov-text-secondary);
  margin-bottom: 8rpx;
}

.voucher-link {
  color: var(--gov-primary);
  margin-left: 8rpx;
}

.card-content {
  font-size: 26rpx;
  color: var(--gov-text-secondary);
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-footer {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--gov-border-light);
}

.card-email {
  font-size: 24rpx;
  color: var(--gov-text-muted);
  margin-bottom: 12rpx;
}

.card-actions {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.action-btn {
  background: var(--gov-card);
  color: var(--gov-text-secondary);
  border: 1rpx solid var(--gov-border);
  border-radius: var(--gov-radius);
  font-size: 24rpx;
  margin: 0;
}

.action-btn.primary {
  background: var(--gov-primary);
  color: #fff;
  border-color: var(--gov-primary);
}

.action-btn.danger {
  color: var(--gov-red);
  border-color: #f5c6cb;
  background: #fff;
}

.load-more {
  padding: 28rpx 0 12rpx;
  text-align: center;
  color: var(--gov-text-muted);
  font-size: 24rpx;
}

.load-more.loaded-all {
  color: var(--gov-text-secondary);
}